# LLM Chat Shell - Configuration
# Copy to .env and set your values.

# Timeout phases (ms) - total max wait = CtrlC + SIGTERM + SIGKILL
# Phase 1: Ctrl+C (interrupts command, bash stays alive)
# LLM_CHAT_SHELL_CTRL_C_TIMEOUT=30000
# Phase 2: SIGTERM (terminates bash gracefully)
# LLM_CHAT_SHELL_SIGTERM_TIMEOUT=5000
# Phase 3: SIGKILL (force kills bash, session dies)
# LLM_CHAT_SHELL_KILL_TIMEOUT=5000

# Max concurrent sessions (default: 10)
# LLM_CHAT_SHELL_MAX_SESSIONS=10

# Session idle timeout in ms (default: 3600000 = 1 hour)
# LLM_CHAT_SHELL_SESSION_TIMEOUT=3600000

# Idle timeout in ms for background jobs without an explicit `timeout`
# param (default: 3600000 = 1 hour). Long-running silent background jobs are
# not killed by the short foreground ctrl-c timeout.
# LLM_CHAT_SHELL_BACKGROUND_TIMEOUT=3600000

# Upper bound in ms for LLM-supplied `timeout` values; larger requests are
# capped to this value. 0 disables the cap (default: 3600000 = 1 hour).
# LLM_CHAT_SHELL_MAX_TIMEOUT=3600000

# Permission config file - path to a strict-JSON file with globalPermissions,
# and workspacePermissions (see docs/env.md and shell-config.example.json).
# When unset, defaults apply: deny, no rules, no per-workspace overrides.
# LLM_CHAT_SHELL_CONFIG=/path/to/shell-config.json
